    "description": "南宋名菜，将蟹肉填入橙壳中蒸制，橙香蟹鲜交融",
    "difficulty": "中等",
    "taste_profile": "鲜香酸甜，橙香蟹美",
    "cooking_time": "45分钟",
    "servings": 2,
    "flavor_profile": {"sour": 0.6, "sweet": 0.4, "bitter": 0.1, "spicy": 0.0, "salty": 0.3, "umami": 0.9}
  },
