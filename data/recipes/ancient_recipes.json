[
  {
    "id": "recipe_001",
    "dish_name": "蟹酿橙",
    "source": "《山家清供》卷下",
    "dynasty": "宋代",
    "original_text": "橙用黄熟大者，截顶去瓤，留少液。以蟹膏肉实其内，仍以带枝顶覆之。入小甑，用酒、醋、水蒸熟。用醋、盐供食，香而鲜。",
    "ingredients": [
      {"name": "大橙", "quantity": "2个", "role": "容器兼调味", "notes": "选用黄熟大者"},
      {"name": "蟹膏蟹肉", "quantity": "适量", "role": "主料", "notes": "取膏肉混合"},
      {"name": "酒", "quantity": "少许", "role": "调味", "notes": "黄酒为佳"},
      {"name": "醋", "quantity": "适量", "role": "蘸料", "notes": "米醋"},
      {"name": "盐", "quantity": "少许", "role": "调味"}
    ],
    "steps": [
      "选取黄熟大橙，截取顶部作盖，挖去橙瓤，保留少许汁液",
      "将蟹膏蟹肉混合，填入橙壳内",
      "将橙盖覆回，用牙签固定",
      "放入小甑中，加入酒和少许水",
      "大火蒸制约15-20分钟至熟透",
      "取出后用醋和盐调蘸汁供食"
    ],
    "restoration_difficulty": "中等",
    "modern_adaptation": "可用砂锅或蒸锅替代小甑，大闸蟹或梭子蟹均可",
    "cultural_notes": "此菜体现了宋人饮食的精致与风雅，橙香与蟹鲜交融，是山林清供的代表"
  },
  {
    "id": "recipe_002",
    "dish_name": "槐叶冷淘",
    "source": "《山家清供》卷上",
    "dynasty": "唐代",
    "original_text": "于夏采槐叶之高者，汤焯，漉之，研细滤清，和面作淘。以酱醋熟油拌之，供之。",
    "ingredients": [
