# Demo runtime
NODE_ENV=development
PORT=3001
FRONTEND_PORT=5173
VITE_API_BASE=http://localhost:3001/api
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_DISABLED=false

# Auth
JWT_SECRET=change-me-for-local-demo
JWT_EXPIRES_IN=7d

# Python bridge / OpenAI-compatible reasoning
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MODEL_NAME=doubao-pro-32k
OPENAI_VISION_MODEL=gpt-4.1-mini

# Image generation
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_IMAGE_MODEL=agnes-image-2.0-flash
AGNES_IMAGE_SIZE=1024x768
AGNES_BACKGROUND_SIZE=1536x1024

# Optional external AI service placeholder
AI_SERVICE_URL=http://localhost:5000/api
AI_API_KEY=
